{
  "dataset_id": "day03_answers",
  "dataset_role": "answers",
  "description": "Chấm CÂU TRẢ LỜI CUỐI (đa lượt) bằng run_answer_eval.py: ngôn ngữ, URL có thật, không trùng, còn mới. clarify_reply chỉ được dùng nếu agent hỏi lại.",
  "cases": [
