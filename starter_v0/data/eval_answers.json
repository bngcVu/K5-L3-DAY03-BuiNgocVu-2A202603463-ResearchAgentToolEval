      "expect": {"language": "vi", "requires_sources": true, "timeframe": "week"}
    },
    {
      "id": "A04_vague_new_news",
      "turns": ["cho mình xem tin mới"],
      "clarify_reply": "Tin công nghệ",
      "expect": {"language": "vi", "requires_sources": true}
    },
    {
      "id": "A05_tweets_account",
